{
  "name": "@vivancedata/ui",
  "version": "0.3.0",
  "description": "Vivancedata design system and component library",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "dist/index.js",
  "module": "src/index.ts",
  "types": "dist/index.d.ts",
  "bin": {
    "vivance-ui-boundary": "./bin/check-ui-boundary.mjs"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "tailwind.preset.ts",
    "tailwind.config.ts",
    "DESIGN.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js"
    },
    "./styles": "./src/styles/globals.css",
    "./tailwind": "./tailwind.preset.ts",
    "./tailwind-config": "./tailwind.config.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external react",
    "dev": "tsup src/index.ts --format cjs,esm --dts --external react --watch",
    "lint": "eslint src/",
    "react-doctor:score": "npx -y react-doctor@latest . --score",
    "react-doctor:ci": "node scripts/check-react-doctor-score.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "framer-motion": ">=10.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=3.4.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.0.0",
    "embla-carousel-react": "^8.1.6",
    "lucide-react": "^0.475.0",
    "next-themes": "^0.4.6",
    "react-hook-form": "^7.52.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.4",
    "framer-motion": "^11.0.0",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "vivancedata",
    "ui",
    "components",
    "react",
    "tailwindcss",
    "design-system",
    "geist"
  ],
  "author": "Lorenzo Scaturchio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vivancedata/ui.git"
  }
}
